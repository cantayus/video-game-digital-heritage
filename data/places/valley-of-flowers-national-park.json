{"id":"valley-of-flowers-national-park","name":"Valley of Flowers National Park","qid":"Q605897","country":"India","locality":"Uttarakhand","lat":"30.73","lon":"79.6175","built":"1982","year":1982,"year_text":"1982","century":"20th century","era":"20th century and later","period":"","date_basis":"description text (approximate)","style":"","heritage":"World Heritage Site","type":"biosphere reserve; national park","wikipedia":"https://en.wikipedia.org/wiki/Valley_of_Flowers_National_Park","text":"Valley of Flowers National Park is an Indian national park which was established in 1982. It is located in Chamoli in the state of Uttarakhand and is known for its meadows of endemic alpine flowers and the variety of flora. This richly diverse area is also home to rare and endangered animals, including the Asiatic black bear, snow leopard, musk deer, brown bear, red fox and blue sheep.","text_source":"https://en.wikipedia.org/wiki/Valley_of_Flowers_National_Park","text_license":"CC BY-SA 4.0","real":[{"id":"gh-316f40029c7c","w":1200,"h":900,"title":"\"Flowers Blossom at Valley of Flowers Chamoli, India\" 58.jpg","o":"gh-316f40029c7c.jpg","credit":{"text":"Naresh Chandra","license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","source":"https://commons.wikimedia.org/wiki/File:%22Flowers_Blossom_at_Valley_of_Flowers_Chamoli%2C_India%22_58.jpg","via":"Wikimedia Commons"}}],"depictions":[{"id":"civilization-vii--valley-of-flowers","game":"civilization-vii","name":"Valley of Flowers","verified":false,"text":"","text_source":"","text_license":"","images":[{"id":"gh-pa1001e59166","w":1200,"h":675,"o":"gh-pa1001e59166.png","credit":{"text":"Screenshot from Civilization VII, © 2K.","source":"https://civilization.fandom.com/wiki/File:Valley_of_Flowers_in-game_(Civ7).png","via":"Fandom (civilization)","note":"Fandom upload by Jostriker on 2026-06-19"}}]}]}