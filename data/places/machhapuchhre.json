{"id":"machhapuchhre","name":"Machhapuchhre","qid":"Q1051394","country":"Nepal","locality":"Gandaki Zone","lat":"28.495","lon":"83.949166666","built":"","year":null,"year_text":"","century":"","era":"Natural formations","period":"","date_basis":"","style":"","heritage":"","type":"mountain; sacred mountain; virgin peak","wikipedia":"https://en.wikipedia.org/wiki/Machapuchare","text":"Machapuchare, Machhapuchchhre or Machhapuchhre (Nepali: माछापुच्छ्रे, lit. 'fishtail'; Tamu: कतासुँ क्लिको), is a mountain situated in the Annapurna massif of Gandaki Province, north-central Nepal. Its highest peak has never been officially climbed due to the impossibility of gaining a permit from the government of Nepal.","text_source":"https://en.wikipedia.org/wiki/Machapuchare","text_license":"CC BY-SA 4.0","real":[{"id":"gh-0a01212ce39f","w":1280,"h":885,"title":"Ghorepani-Tadapani-34-Machhapuchhre-2013-gje.jpg","credit":{"text":"Gerd Eichmann","license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","source":"https://commons.wikimedia.org/wiki/File:Ghorepani-Tadapani-34-Machhapuchhre-2013-gje.jpg","via":"Wikimedia Commons"}}],"depictions":[{"id":"civilization-vii--machapuchare","game":"civilization-vii","name":"Machapuchare","verified":false,"text":"","text_source":"","text_license":"","images":[{"id":"gh-pf300b4bb07c","w":1400,"h":788,"credit":{"text":"Screenshot from Civilization VII, © 2K.","source":"https://civilization.fandom.com/wiki/File:Machapuchare_in-game_(Civ7).png","via":"Fandom (civilization)","note":"Fandom upload by Jostriker on 2026-06-19"}}]}]}